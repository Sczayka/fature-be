generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  createdTransactions   InvoiceTransaction[] @relation("InvoiceTransactionCreatedBy")
  reviewedTransactions  InvoiceTransaction[] @relation("InvoiceTransactionReviewedBy")
  cancelledTransactions InvoiceTransaction[] @relation("InvoiceTransactionCancelledBy")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// Estrutura Multi-tenant (Isolamento de Clientes do Fature)
model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  String?

  // --- Novos campos da Empresa / Faturamento ---
  cnpj        String?
  companyType String?
  phone       String?
  mobilePhone String?
  incomeValue Float?

  // --- Novos campos de Endere�o ---
  address       String?
  addressNumber String?
  complement    String?
  province      String?
  postalCode    String?

  // --- Personalização (checkout e e-mails); null = padrão do Fature ---
  wallpaper       String? // WALLPAPERS (customization.constants.ts)
  backgroundColor String? // #rrggbb
  buttonColor     String? // #rrggbb
  logoImage       OrganizationLogo?

  // Reply-To dos e-mails aos pagadores (aba Dados da empresa); null = sem Reply-To
  contactEmail String?

  // --- E-mails automáticos aos pagadores (aba Notificações) ---
  notifyInvoiceIssued   Boolean @default(true)
  notifyInvoiceReminder Boolean @default(true)
  invoiceReminderDays   Int     @default(3) // Dias antes do vencimento
  notifyInvoiceOverdue  Boolean @default(true)
  notifyInvoicePaid     Boolean @default(true)

  // --- Pagamento manual: liberado pelo admin do Fature (bankTransferEnabled por SQL; pixMode pelo script payments:pix-mode) ---
  // Liberar a transferência: UPDATE "Organization" SET "bankTransferEnabled" = true WHERE id = '<organizationId>';
  bankTransferEnabled Boolean                  @default(false)
  pixMode             String                   @default("AUTOMATIC") // AUTOMATIC, MANUAL
  bankAccount         OrganizationBankAccount?

  // --- E-mails do pagamento manual (aba Notificações) ---
  notifyPaymentProofReceived Boolean @default(true) // À empresa: comprovante chegou
  notifyPaymentProofRejected Boolean @default(true) // Ao pagador: comprovante recusado
  notifyPartialPayment       Boolean @default(true) // Ao pagador: valor confirmado não cobriu a fatura

  emailLogs EmailLog[]

  members     Member[]
  invitations Invitation[]
  items       Item[]
  clients     Client[]
  brands      Brand[]
  suppliers   Supplier[]
  promotions  Promotion[]

  invoices        Invoice[]
  invoiceDrafts   InvoiceDraft[]
  gatewayAccounts PaymentGatewayAccount[]
}

/// Imagem do logo, já recortada pelo fature-fe. Organization.logo guarda a URL pública dela
/// (GET /logos/{organizationId}?v={versão}).
model OrganizationLogo {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  mimeType       String
  updatedAt      DateTime     @updatedAt
}

// Dados que a empresa mostra no checkout para transferência e PIX manual (aba Dados bancários)
model OrganizationBankAccount {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankCode       String? // Código COMPE (3 dígitos)
  bankName       String?
  branch         String? // Agência
  accountNumber  String? // Conta com dígito
  accountType    String? // BANK_ACCOUNT_TYPES (suppliers.constants.ts)
  holderName     String?
  holderDocument String? // CPF/CNPJ do titular, só dígitos
  pixKeyType     String? // PIX_KEY_TYPES (suppliers.constants.ts)
  pixKey         String? // Normalizada (normalizePixKey)
  updatedAt      DateTime     @updatedAt
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
}

// Items da organiza��o (Produtos e Servi�os)
model Item {
  id             String          @id @default(cuid())
  name           String
  price          Float
  type           String
  stock          Int             @default(0)
  description    String?
  // Só produto: serviço não tem marca
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  suppliers      ItemSupplier[]
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoices       Invoice[]
  promotions     PromotionItem[]

  @@index([organizationId])
  @@index([brandId])
}

/// Fornecedores do item (produto ou serviço): no máximo um principal e nenhum repetido. A lista é
/// gravada por substituição (ItemsService).
model ItemSupplier {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierCode  String? // Código do item no fornecedor
  purchasePrice Float? // Preço de compra, em 2 casas como Item.price
  isMain        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([itemId, supplierId])
  @@index([supplierId])
}

/// Marcas dos produtos. Só é excluída sem produtos (BrandsService); em uso, é inativada.
model Brand {
  id             String          @id @default(cuid())
  name           String // Único na organização sem diferenciar maiúsculas (conferido no service)
  active         Boolean         @default(true)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          Item[]
  suppliers      SupplierBrand[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Promoções e descontos pré-definidos dos itens. A cobrança guarda uma cópia das regras usadas
/// (Invoice.discount.items[].promotion): editar ou inativar a promoção não muda as já emitidas.
/// Só é excluída sem cobranças (PromotionsService); usada, é inativada.
model Promotion {
  id             String          @id @default(cuid())
  name           String // Único na organização sem diferenciar maiúsculas (conferido no service)
  type           String // AMOUNT_TYPES: FIXED (R$) ou PERCENTAGE
  value          Float
  application    String // PROMOTION_APPLICATIONS: UNIT (em cada unidade) ou TOTAL (uma vez na linha)
  maxAmount      Float? // Teto do desconto na linha, em R$; null = sem teto
  maxQuantity    Int? // Unidades da linha que a promoção atinge; null = todas
  // Validade, gravada à meia-noite UTC como o vencimento da fatura; null = sem limite
  startsAt       DateTime?
  endsAt         DateTime? // Último dia, inclusive
  active         Boolean         @default(true)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          PromotionItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Itens em que a promoção pode ser usada. A lista é gravada por substituição (PromotionsService).
model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, itemId])
  @@index([itemId])
}

/// Fornecedores de produtos e de serviços (terceirizados); as contas a pagar usam o mesmo
/// cadastro. Só é excluído sem itens vinculados (SuppliersService); em uso, é inativado.
model Supplier {
  id                   String                @id @default(cuid())
  name                 String // Razão social ou nome da pessoa
  tradeName            String? // Nome fantasia
  // E-mail e telefones da empresa; as pessoas ficam em contacts
  email                String?
  phone                String?
  mobile               String?
  cpfCnpj              String? // Só dígitos
  municipalInscription String?
  stateInscription     String?
  cep                  String?
  addressLine          String?
  addressNumber        String?
  complement           String?
  district             String?
  state                String?
  city                 String?
  // Dias de cada parcela, contados da compra: [30], [30, 60, 90] ou [0] (à vista); vazio = não informado
  paymentTermDays      Int[]                 @default([])
  notes                String?
  active               Boolean               @default(true)
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  brands               SupplierBrand[]
  contacts             SupplierContact[]
  bankAccounts         SupplierBankAccount[]
  items                ItemSupplier[]

  @@unique([organizationId, name])
  @@unique([organizationId, cpfCnpj])
  @@index([organizationId])
}

/// Marcas que o fornecedor vende ("quem me vende a marca X?").
model SupplierBrand {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([supplierId, brandId])
  @@index([brandId])
}

/// Pessoas de contato do fornecedor; no máximo uma principal (conferido no service).
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String? // Cargo ou setor
  email      String?
  phone      String?
  mobile     String?
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
}

/// Contas para pagar o fornecedor; no máximo uma principal. As contas a pagar apontam para o id,
/// que se mantém nas edições. Dados sensíveis: só saem no detalhe do fornecedor e não vão para log.
model SupplierBankAccount {
  id             String   @id @default(cuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bankCode       String? // Código COMPE (3 dígitos)
  bankName       String?
  branch         String? // Agência
  accountNumber  String? // Conta com dígito
  accountType    String? // BANK_ACCOUNT_TYPES (suppliers.constants.ts)
  holderName     String?
  holderDocument String? // CPF/CNPJ do titular, só dígitos
  pixKeyType     String? // PIX_KEY_TYPES (suppliers.constants.ts)
  pixKey         String?
  isMain         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supplierId])
}

// Clientes da organiza��o
model Client {
  id                   String                   @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  mobile               String?
  cpfCnpj              String?
  municipalInscription String?
  stateInscription     String?
  cep                  String?
  addressLine          String?
  addressNumber        String?
  complement           String?
  district             String?
  state                String?
  city                 String?
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  // Exclusão lógica (DELETE /clients/:id): some da lista e da busca, e as faturas, os orçamentos
  // e os e-mails dele continuam no histórico
  deletedAt            DateTime?
  invoices             Invoice[]
  gatewayCustomers     PaymentGatewayCustomer[]
  emailLogs            EmailLog[]

  @@index([organizationId])
}

// Conta da organizacao em um provedor de pagamento (criada no registro da organizacao)
model PaymentGatewayAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider  String // Ex: "ASAAS", "PAGARME"
  accountId String // ID da subconta no provedor (vazio ate o onboarding)
  status    String // AWAITING_COMPANY_INFO, PENDING, ACTIVE, FAILED
  metadata  Json? // Dados da conta no provedor (credenciais cifradas)

  methods   PaymentGatewayMethod[] // Taxas negociadas entre a organizacao e o Fature
  charges   InvoiceCharge[]
  customers PaymentGatewayCustomer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[] // Legado: removido apos o backfill para InvoiceCharge

  @@unique([organizationId, provider]) // Apenas 1 conta do mesmo provedor por organizacao
  @@index([organizationId])
}

// Configura��o de Pagamento da Organiza��o (Taxas cobradas do Cliente)
model PaymentGatewayMethod {
  id String @id @default(cuid())

  paymentGatewayAccountId String
  paymentGatewayAccount   PaymentGatewayAccount @relation(fields: [paymentGatewayAccountId], references: [id], onDelete: Cascade)

  method             String // Codigo do Fature: "BANK_SLIP", "PIX", "CREDIT_CARD", "DEBIT_CARD"
  active             Boolean @default(true)
  isDefaultForMethod Boolean @default(false) // Provedor que processa o metodo para a organizacao (o de menor custo)

  feeFixed   Float @default(0)
  feePercent Float @default(0)

  receiptDays Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentGatewayAccountId, method])
  @@index([paymentGatewayAccountId])
}

// Configura��es globais dos Provedores (Custo do Fature / Administra��o)
model PlatformPaymentMethod {
  id       String @id @default(cuid())
  provider String // Ex: "ASAAS", "PAGARME"
  method   String // Codigo do Fature: "BANK_SLIP", "PIX", "CREDIT_CARD", "DEBIT_CARD"

  // Custo negociado entre o Fature e o provedor
  costFixed   Float @default(0)
  costPercent Float @default(0)

  // Taxa padrao do Fature para as organizacoes (copiada no registro da organizacao)

  defaultFeeFixed   Float @default(0)
  defaultFeePercent Float @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, method])
}

// Faturas/Cobrancas
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  // Cliente com faturas não é apagado do banco: a exclusão é lógica (Client.deletedAt)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  items         Json // Array de itens: { id, name, type, price, quantity, total }
  totalValue    Float // Valor nominal (subtotal menos descontos por item): valor do boleto e base de multa/juros
  dueDate       DateTime
  referenceDate DateTime?
  description   String?
  status        String // Ex: PENDING, PAID, OVERDUE, CANCELLED

  // Metodos de pagamento habilitados na emissao (as cobrancas ficam em InvoiceCharge)
  paymentMethods String[] @default([]) @map("enabledPaymentMethods")

  // Regras usadas para calcular o valor de cada metodo de pagamento
  // items[].promotion: cópia da promoção usada ({ id, name, application, maxAmount, maxQuantity }); null = desconto digitado
  discount        Json? // { items: [{ id, type, value, promotion }], methods: [{ method, type, value, limitDate }] }
  interestAndFine Json? // { fineType, fineValue, interestType, interestValue }

  // Token da URL publica de pagamento: /pagar/{checkoutToken}
  checkoutToken String? @unique

  // Pagamento confirmado: calculado das transações (InvoiceTransactionsService.applyBalance)
  paidAt      DateTime?
  paidMethod  String?
  paidValue   Float? // Recebido líquido
  excessValue Float     @default(0) // Excedente recebido e ainda não devolvido

  charges      InvoiceCharge[]
  transactions InvoiceTransaction[]
  emailLogs    EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      Item?    @relation(fields: [itemId], references: [id])
  itemId    String?

  // Legado (antes de InvoiceCharge): lidos apenas pelo backfill e removidos depois dele
  legacyPaymentMethods    Json?                  @map("paymentMethods")
  meta                    Json?
  gatewayIds              String[]               @default([])
  paymentGatewayAccount   PaymentGatewayAccount? @relation(fields: [paymentGatewayAccountId], references: [id])
  paymentGatewayAccountId String?

  @@index([organizationId])
  @@index([clientId])
  @@index([dueDate])
}

// Cobranca gerada em um provedor para uma fatura (uma linha por cobranca, inclusive as substituidas)
model InvoiceCharge {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method String // BANK_SLIP, PIX, CREDIT_CARD

  // A conta define o provedor da cobranca
  paymentGatewayAccountId String
  paymentGatewayAccount   PaymentGatewayAccount @relation(fields: [paymentGatewayAccountId], references: [id], onDelete: Cascade)
  externalId              String // ID da cobranca no provedor

  status     String // PENDING, PAID, CANCELLED
  value      Float
  dueDate    DateTime
  validUntil DateTime? // Ultimo dia em que o valor calculado vale (cobrancas geradas no checkout)

  // Retrato das taxas no momento da cobranca
  feeFixed    Float @default(0)
  feePercent  Float @default(0)
  costFixed   Float @default(0)
  costPercent Float @default(0)
  feeAmount   Float @default(0)
  costAmount  Float @default(0)
  splitAmount Float @default(0)

  details          Json? // Dados exibidos ao pagador: URLs, linha digitavel, PIX copia e cola
  providerResponse Json? // Resposta completa do provedor

  paidAt    DateTime?
  paidValue Float?

  transactions InvoiceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentGatewayAccountId, externalId])
  @@index([invoiceId])
}

// Dinheiro que entrou ou saiu por uma fatura: pagamentos e devoluções (card Movimentações da fatura)
model InvoiceTransaction {
  id        String  @id // Gerado no código (randomUUID) antes do upload do comprovante
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type       String // PAYMENT (entrada), REFUND (saída)
  method     String // PAYMENT_METHODS
  amount     Decimal?  @db.Decimal(12, 2) // Sempre positivo; null enquanto PENDING_REVIEW
  occurredAt DateTime? // Quando o dinheiro entrou ou saiu; null enquanto PENDING_REVIEW

  status       String // PENDING_REVIEW, CONFIRMED, REJECTED, CANCELLED
  statusReason String? // Motivo da recusa (mostrado ao pagador) ou do cancelamento
  source       String // GATEWAY, CHECKOUT, OPERATOR

  // Só no gateway
  chargeId       String?
  charge         InvoiceCharge?       @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  gatewayEventId String?              @unique // Estornos do provedor (fase 2)
  gatewayEvent   PaymentGatewayEvent? @relation(fields: [gatewayEventId], references: [id], onDelete: SetNull)

  bankReference String? // ID E2E do PIX ou autenticação da TED, digitado pelo operador

  // Comprovante no armazenamento de objetos (R2); null no gateway
  proofKey      String?
  proofMimeType String?
  proofSize     Int?
  proofName     String?
  proofSha256   String?

  createdById   String? // null = pagador ou gateway
  createdBy     User?     @relation("InvoiceTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?     @relation("InvoiceTransactionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("InvoiceTransactionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?

  notes String? // Observação interna

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([chargeId])
  @@index([bankReference])
  @@index([proofSha256])
}

// Cliente da organizacao dentro de uma conta de provedor (criado na primeira cobranca roteada para ela)
model PaymentGatewayCustomer {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  paymentGatewayAccountId String
  paymentGatewayAccount   PaymentGatewayAccount @relation(fields: [paymentGatewayAccountId], references: [id], onDelete: Cascade)

  externalId String // ID do cliente no provedor
  metadata   Json? // Resposta do provedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, paymentGatewayAccountId])
  @@index([paymentGatewayAccountId])
}

// Eventos recebidos dos provedores via webhook (idempotencia: o mesmo evento pode chegar mais de uma vez)
model PaymentGatewayEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  transaction InvoiceTransaction?

  @@unique([provider, externalEventId])
}

// Orcamentos: dados do formulario de invoice salvos sem gerar cobranca
model InvoiceDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  client          Json? // Snapshot do bloco client (id pode estar vazio)
  items           Json     @default("[]") // [{ item: { id, name, type, price }, quantity, total }]
  billing         Json? // { dueDate, referenceDate, description }
  paymentMethods  String[] @default([])
  discount        Json? // { items: [...], methods: [...] }
  interestAndFine Json? // { fineType, fineValue, interestType, interestValue }

  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// E-mails aos pagadores: registro exibido na tela do cliente e fila de envio (outbox).
/// Tipos e status em src/email/email.constants.ts.
model EmailLog {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // A exclusão do cliente é lógica (Client.deletedAt): o histórico de envios dele fica
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // O orçamento é apagado ao virar cobrança; o registro do envio fica
  invoiceDraftId String?
  invoiceDraft   InvoiceDraft? @relation(fields: [invoiceDraftId], references: [id], onDelete: SetNull)

  type        String // INVOICE_ISSUED, INVOICE_REMINDER, INVOICE_OVERDUE, INVOICE_PAID, QUOTE, PAYMENT_PROOF_RECEIVED, PAYMENT_PROOF_REJECTED, INVOICE_PARTIALLY_PAID
  source      String // AUTOMATIC, MANUAL
  requestedBy String? // User.id de quem pediu o envio manual

  // Mensagem como enviada: as novas tentativas reenviam exatamente o mesmo conteúdo
  recipient   String? // null = SKIPPED por falta de e-mail
  sender      String
  replyTo     String?
  subject     String
  html        String? // Apagado depois do período de retenção
  text        String?
  // [{ filename, contentType, content (base64) }]; apagado junto com o corpo
  attachments Json?

  status            String // QUEUED, SENDING, SENT, RETRYING, FAILED, SKIPPED
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now()) // Em SENDING: fim da reserva do envio
  lastError         String? // Motivo exibido na tela do cliente
  providerMessageId String?
  sentAt            DateTime?

  // Automáticos: um por fatura e tipo (e vencimento, nos lembretes); null nos manuais
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, clientId, createdAt])
  @@index([invoiceId])
  @@index([status, nextAttemptAt])
}
