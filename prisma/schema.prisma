generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// Estrutura Multi-tenant (Isolamento de Clientes do Fature)
model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  String?

  // --- Novos campos da Empresa / Faturamento ---
  cnpj        String?
  companyType String?
  phone       String?
  mobilePhone String?
  incomeValue Float?

  // --- Novos campos de Endere�o ---
  address       String?
  addressNumber String?
  complement    String?
  province      String?
  postalCode    String?

  members     Member[]
  invitations Invitation[]
  items       Item[]
  clients     Client[]

  invoices        Invoice[]
  invoiceDrafts   InvoiceDraft[]
  gatewayAccounts PaymentGatewayAccount[]
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
}

// Items da organiza��o (Produtos e Servi�os)
model Item {
  id             String       @id @default(cuid())
  name           String
  price          Float
  type           String
  stock          Int          @default(0)
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  invoices       Invoice[]

  @@index([organizationId])
}

// Clientes da organiza��o
model Client {
  id                   String       @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  mobile               String?
  cpfCnpj              String?
  municipalInscription String?
  stateInscription     String?
  cep                  String?
  addressLine          String?
  addressNumber        String?
  complement           String?
  district             String?
  state                String?
  city                 String?
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  invoices             Invoice[]

  @@index([organizationId])
}

// Nova tabela para os Provedores de Pagamento
model PaymentGatewayAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider  String // Ex: "ASAAS", "STRIPE"
  accountId String // ID da subconta no provedor
  status    String // Ex: "ACTIVE", "PENDING"
  metadata  Json? // JSON completo retornado na cria��o da conta

  methods PaymentGatewayMethod[] // Rela��o com as taxas cobradas desta conta

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@unique([organizationId, provider]) // Garante apenas 1 conta do mesmo provedor por Organiza��o
  @@index([organizationId])
}

// Configura��o de Pagamento da Organiza��o (Taxas cobradas do Cliente)
model PaymentGatewayMethod {
  id String @id @default(cuid())

  paymentGatewayAccountId String
  paymentGatewayAccount   PaymentGatewayAccount @relation(fields: [paymentGatewayAccountId], references: [id], onDelete: Cascade)

  method             String // Ex: "PIX", "BOLETO", "CREDIT_CARD"
  active             Boolean @default(true)
  isDefaultForMethod Boolean @default(true)

  feeFixed   Float @default(0)
  feePercent Float @default(0)

  receiptDays Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentGatewayAccountId, method])
  @@index([paymentGatewayAccountId])
}

// Configura��es globais dos Provedores (Custo do Fature / Administra��o)
model PlatformPaymentMethod {
  id       String @id @default(cuid())
  provider String // Ex: "ASAAS", "STRIPE"
  method   String // Ex: "PIX", "BOLETO", "CREDIT_CARD"

  costFixed   Float @default(0)
  costPercent Float @default(0)

  defaultFeeFixed   Float @default(0)
  defaultFeePercent Float @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, method])
}

// Faturas/Cobrancas
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  items         Json // Array de itens: { id, name, type, price, quantity, total }
  totalValue    Float // Valor nominal (subtotal menos descontos por item): valor do boleto e base de multa/juros
  dueDate       DateTime
  referenceDate DateTime?
  description   String?
  status        String // Ex: PENDING, PAID, OVERDUE, CANCELLED

  // Metodos de pagamento habilitados -> dados da cobranca gerada no provedor (null = gerar no checkout)
  paymentMethods Json // Ex: { BANK_SLIP: { gatewayId: "pay_123", gatewayProvider: "ASAAS", ... }, PIX: null }

  // Regras usadas para calcular o valor de cada metodo de pagamento
  discount        Json? // { items: [{ id, type, value }], methods: [{ method, type, value, limitDate }] }
  interestAndFine Json? // { fineType, fineValue, interestType, interestValue }

  // Resposta completa dos provedores
  meta Json? // Ex: { BANK_SLIP: { provider: "ASAAS", data: {...} } }

  // Array de IDs externos (gatewayId) para busca rapida via Webhooks
  gatewayIds String[]

  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  item                    Item?                  @relation(fields: [itemId], references: [id])
  itemId                  String?
  paymentGatewayAccount   PaymentGatewayAccount? @relation(fields: [paymentGatewayAccountId], references: [id])
  paymentGatewayAccountId String?

  @@index([organizationId])
  @@index([clientId])
}

// Orcamentos: dados do formulario de invoice salvos sem gerar cobranca
model InvoiceDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  client          Json? // Snapshot do bloco client (id pode estar vazio)
  items           Json     @default("[]") // [{ item: { id, name, type, price }, quantity, total }]
  billing         Json? // { dueDate, referenceDate, description }
  paymentMethods  String[] @default([])
  discount        Json? // { items: [...], methods: [...] }
  interestAndFine Json? // { fineType, fineValue, interestType, interestValue }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}
