meta {
  name: Pay With Credit Card
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/checkout/{{checkoutToken}}/credit-card
  body: json
  auth: none
}

body:json {
  {
    "mode": "RAW",
    "card": {
      "holderName": "TITULAR TESTE",
      "number": "4444444444444444",
      "expiryMonth": "12",
      "expiryYear": "2030",
      "ccv": "123"
    },
    "holder": {
      "name": "Titular Teste",
      "email": "titular@email.com",
      "cpfCnpj": "24971563792",
      "postalCode": "01001000",
      "addressNumber": "10",
      "phone": "11999999999"
    }
  }
}

docs {
  Cartão de teste do sandbox do Asaas. Limite: 5 tentativas por hora por fatura (429 depois).
  O modo vem de `cardCapture.mode` em GET /checkout/:token (RAW = formulário do Fature).
}
