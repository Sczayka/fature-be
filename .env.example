DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"
PORT=3000
NODE_ENV=development

# Better Auth: BETTER_AUTH_URL é a URL pública do backend (os links de verificação de e-mail apontam para ela)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

FRONTEND_URL="http://localhost:3001"

# Asaas
ASAAS_API_KEY=
ASAAS_API_URL="https://sandbox.asaas.com/api"

# Pagamentos (núcleo multiprovedor)
PAYMENT_GATEWAY_ENCRYPTION_KEY=
PAYMENT_ROUTING_REFERENCE_AMOUNT=100
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLATFORM_WALLET_ID=
# URL pública do backend (webhooks e logos); localmente, um túnel (cloudflared ou ngrok)
# BACKEND_PUBLIC_URL=
# TRUST_PROXY=

# E-mails (Resend)
# Vazio = os e-mails só aparecem no log (desenvolvimento)
RESEND_API_KEY=
# Endereço do domínio verificado no Resend
EMAIL_FROM="nao-responda@mail.fature.com.br"
EMAIL_FROM_NAME="Fature"
# Opcional (desenvolvimento e homologação): todo e-mail vai para este endereço
# EMAIL_REDIRECT_TO=
# false desliga os agendamentos e a fila de e-mails nesta instância
EMAIL_WORKERS_ENABLED=true
